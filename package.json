{
  "name": "leetlock",
  "version": "0.1.0",
  "private": true,
  "description": "Turn distracting websites into mini coding-interview gates. Solve a problem, earn timed access.",
  "type": "module",
  "license": "MIT",
  "author": "Jeremy Liu",
  "homepage": "https://github.com/Jeremyliu-621/leet",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeremyliu-621/leet.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:watch": "vite build --watch --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "codemirror": "^6.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
